generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  ATTORNEY
  INVESTIGATOR
  VIEWER
  SUPPORT // staff: customer-facing reads + safe unblocking actions, never money or deletion
  CLIENT // consumer purchaser in a single-member tenant (ENG-7, auth design §12)
}

// ── Identity expand step (persona_rollout_plan.md §5 A, 2026-10-19) ─────────
// `Role` keeps working unchanged. The three enums below are the target model
// (Staff Console Access Model): WHO a person is (AccountKind), what STAFF may
// do (StaffGrant), and what a professional may do inside their organisation
// (MembershipRole). The contract step (dropping Role) is a later, founder-run
// migration; until then packages/database/staff.ts reconciles the two.

// FAMILY: a consumer in a single-member tenant. PROFESSIONAL: an attorney,
// investigator or clinic member inside an Organisation. STAFF: our people.
enum AccountKind {
  FAMILY
  PROFESSIONAL
  STAFF
}

// What a staff member may do; a person holds a SET. ADMIN implies SUPPORT in
// the helpers (never by data), mirroring staff_console.md §1.
enum StaffGrantKind {
  ADMIN
  SUPPORT
  REVIEWER // the QA reviewer (today Role.ATTORNEY)
}

enum OrganisationKind {
  FIRM
  PD_OFFICE
  CLINIC
  FAMILY
}

enum MembershipRole {
  OWNER
  ATTORNEY
  INVESTIGATOR
  VIEWER
}

// One Organisation per Tenant (1:1 profile), so RLS stays tenant-scoped and
// every existing tenant table is already the organisation's data. Pilot,
// allowance and feature overrides live here; the price book (workstream B)
// and the feature flags (J) read them.
model Organisation {
  id                String           @id @default(cuid())
  tenantId          String           @unique
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind              OrganisationKind
  name              String
  legalName         String?
  billingEmail      String?
  pilot             Boolean          @default(false)
  pilotEndsAt       DateTime?
  allowanceRecords  Int              @default(0)
  allowanceResetsAt DateTime?
  features          Json             @default("{}")
  isTest            Boolean          @default(false) // excluded from Money and analytics (plan §7)
  // Workstream I: the public-interest allowance (clinics, plan §4) and the
  // security contact named on the office/clinic security one-pager.
  publicInterest    Boolean          @default(false)
  securityContact   String?
  memberships       Membership[]
  invitations       Invitation[]
  packetDeliveries  PacketDelivery[]
  investigations    InvestigationRequest[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// A person's seat in an organisation. tenantId is denormalised so the RLS
// policy is a plain column test like every other tenant table.
model Membership {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tenantId       String
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole
  invitedBy      String?
  createdAt      DateTime       @default(now())

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([tenantId])
}

// Staff grants as a set per person. Revocation is a timestamp, never a
// delete, so "who could do what, when" survives. Backfilled from Role by the
// migration; effectiveStaffGrants() falls back to Role when no row exists.
model StaffGrant {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      StaffGrantKind
  grantedBy String
  grantedAt DateTime       @default(now())
  revokedAt DateTime?

  @@unique([userId, kind])
}

enum PaymentKind {
  REVIEW
  OVERAGE
  RERUN
  REFUND
  PACK // a prepaid five-record pack (workstream B); the credits it issued point back by paymentId
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

// Financial ledger (ENG-5). Retained 7 years — survives case deletion
// (retention matrix §11a.2); caseId/userId are plain references, no FK.
model Payment {
  id              String        @id @default(cuid())
  stripeId        String        @unique // checkout session id (or promo_… for a free purchase)
  paymentIntentId String? // what Stripe keys refunds and disputes by
  chargeId        String?
  caseId          String?
  userId          String
  tenantId        String
  kind            PaymentKind
  status          PaymentStatus @default(PENDING)
  amountCents     Int
  refundedCents   Int           @default(0) // rollup of Refund rows
  refundedAt      DateTime?
  disputedAt      DateTime?
  disputeStatus   String? // open | won | lost
  promoCode       String? // attribution (promo_codes.md §5)
  // Price-book attribution (workstream B): which SKU and rung this money is
  // for, so the Money page can sum by rung. Null on family rows.
  sku             String?
  rung            String? // SHORT | STANDARD | EXTENDED
  // Receipt details for the family's account page, fetched from Stripe once
  // on first view and kept — brand and last four only, never more.
  cardBrand       String?
  cardLast4       String?
  receiptUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([caseId])
  @@index([tenantId])
  @@index([paymentIntentId])
  @@index([status])
  @@index([createdAt])
}

// Support contact log (OPS-6). Free text lives HERE, not in the event
// stream (events are PII-minimal by construction); the matching
// support.contacted event carries only the note id and channel.
model SupportNote {
  id        String   @id @default(cuid())
  caseId    String
  tenantId  String
  channel   String // email | phone | chat | internal
  body      String
  authorId  String
  createdAt DateTime @default(now())

  @@index([caseId])
}

enum StaffRequestType {
  REFUND
  CASE_DELETE
  ACCOUNT_DELETE
}

enum StaffRequestDecision {
  APPROVED
  DECLINED
}

// Request-to-Admin (staff_console_access_model §6): Support records the
// reason once; an Admin decides with it in front of them. One open request
// per case + type (partial unique index in the migration).
model StaffRequest {
  id           String                @id @default(cuid())
  caseId       String
  tenantId     String
  type         StaffRequestType
  reason       String
  note         String?
  amountCents  Int? // REFUND only; null = full
  requestedBy  String
  decision     StaffRequestDecision?
  decidedBy    String?
  decisionNote String?
  createdAt    DateTime              @default(now())
  decidedAt    DateTime?

  @@index([caseId])
  @@index([decision])
}

// Refund ledger (OPS-2): one row per refund actually issued, so partial
// refunds stack and the weekly refund total is a sum, not a guess. Same
// retention and plain-reference rules as Payment.
model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  stripeRefundId String   @unique
  caseId         String?
  tenantId       String
  amountCents    Int
  reason         String // unreadable_record | customer_request | chargeback | other
  note           String?
  issuedBy       String // staff userId, or "stripe" when first seen via webhook
  createdAt      DateTime @default(now())

  @@index([paymentId])
  @@index([tenantId])
  @@index([createdAt])
}

// Stripe webhook idempotency ledger (ENG-5): one row per processed event id.
model PaymentEvent {
  stripeEventId String   @id
  type          String
  processedAt   DateTime @default(now())
}

// The billable-page authority (ENG-3) + OCR record (NFR-6). One row per
// normalized page; the meter, the overage trigger, and refund math all
// COUNT(billable) here — one authority, no drift. Dedup semantics per
// §11a.3: exact-hash duplicates leave billing AND analysis; near-duplicates
// (when perceptual hashing lands) leave billing only.
model DocumentPage {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])
  pageNo        Int
  contentHash   String
  billable      Boolean  @default(true)
  dedupKind     String? // exact | near
  ocrConfidence Float?
  ocrProvider   String? // pdf-text | textract
  createdAt     DateTime @default(now())

  @@index([documentId])
  @@index([contentHash])
}

// ── Analysis pipeline (ENG-2, system design §6) ──────────────────────────────

model AnalysisRun {
  id          String    @id @default(cuid())
  caseId      String
  tenantId    String
  runNo       Int       @default(1)
  modelConfig Json // model/prompt/router versions — a QA'd report is reproducible
  // Case summary extracted from the record (case-lifecycle/summary.ts):
  // person, county, court, cause, offense, dates, verdict, sentence,
  // appeal, prior writs — each fact cited to the record or absent (2026-09-12).
  summary     Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([caseId])
}

// Promo codes (US-12, promo_codes.md): operator-global, owner-written.
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique // stored UPPERCASE
  amountOffCents Int // 1..29900; 29900 = free
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())
  // Workstream B (promo_codes.md §5): a calendar-month cap on top of the
  // lifetime cap, and which audience may redeem the code (null = any).
  maxRedemptionsPerMonth Int?
  audience               String? // FAMILY | ATTORNEY | OFFICE | CLINIC
}

// Customer feedback (customer_feedback_program.md): one row per case,
// upserted across touches. Open text stays HERE only - never in analytics.
model CaseFeedback {
  id               String   @id @default(cuid())
  caseId           String   @unique
  tenantId         String
  clarity          Int? // Q1 CSAT 1-5
  recommend        String? // yes | not_sure | no  (Q2, the value proxy)
  decidedText      String? // "what did this report help you decide?"
  sharedWithLawyer String? // yes | planning | no (touch 2)
  objectionText    String? // "what almost stopped you?"
  followupSentAt   DateTime? // +7d email stamp (idempotence)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// NFR-4 cost telemetry: every model/OCR call writes a row, so per-case
// COGS is a single query. No FK (survives deletion like other ledgers);
// amountUsd is computed from env-configured rates — tokens are the truth,
// dollars are the estimate.
model CostRecord {
  id              String   @id @default(cuid())
  caseId          String
  tenantId        String
  source          String // model | ocr | storage
  provider        String // e.g. claude-opus-5, textract
  detail          String? // screen id, context_prepass, textract job…
  tokensIn        Int?
  tokensOut       Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  pages           Int?
  amountUsd       Float
  createdAt       DateTime @default(now())

  @@index([caseId])
}

// ENG-2 findings schema — the pipeline↔QA↔report contract.
model Finding {
  id           String  @id @default(cuid())
  runId        String
  caseId       String
  tenantId     String
  stableKey    String // hash(category + primary citation) — US-6 re-run diff
  category     String // preserved_error | iac | brady | junk_science | sentencing | deadline | appeal_restoration | new_evidence_flag
  severity     String // dispositive | supportive | background
  confidence   Float
  adjudication String  @default("not_run") // agree | disagree | not_run
  engine       String? // which engine produced the kept copy (multi-engine union)
  screen       String? // the screen that grounded the kept copy (iac | brady | …)
  alsoFoundBy  String[] @default([]) // other screens that grounded the SAME passage
  // Prompt set v2 (analysis-fields.ts): what a manual appellate review tracks per issue.
  preserved     String?  // yes | partial | no | unknown
  preservedCite String?  // verbatim objection/ruling text, kept only when it grounds
  harmStandard  String?  // structural | constitutional | nonconstitutional | none
  vehicle       String?  // direct_appeal | writ | either — derived, never model-asserted
  develop       String?  // the extra-record step that proves or rules the issue out
  dependsOn     String[] @default([]) // records the finding needs that were not provided
  s4Tags       String[] @default([])
  partAText    String
  partBText    String
  provenance   String  @default("ai") // ai | ai_human_edited
  /// UPL review 2026-10-23 (E3): advice-language lint hits on the stored text — { adviceLintHit, partA: [{phrase,index}], partB: [...] }; null when clean.
  lintFlags    Json?
  citations    FindingCitation[]

  @@index([caseId, runId])
}

model FindingCitation {
  id          String  @id @default(cuid())
  findingId   String
  finding     Finding @relation(fields: [findingId], references: [id])
  documentId  String
  volume      String?
  page        Int?
  line        Int?
  chunkId     String // + excerptHash: the FR-7 re-verification anchors
  excerptHash String
  excerpt     String

  @@index([findingId])
}

// ENG-8: QA approval snapshots the exact findings READY will render.
model Report {
  id               String   @id @default(cuid())
  caseId           String
  tenantId         String
  runId            String
  versionNo        Int      @default(1)
  templateVersion  String
  findingsSnapshot Json
  approvedBy       String
  renderedAt       DateTime @default(now())
  /// Republish only: what is different from the prior version, in the family's words.
  changeNotes      Json?

  @@index([caseId])
}

// US-5 consent-based referral: opt-in only, default off, revocable; nothing
// is shared without an explicit grant. Events mirror grants/revocations.
model ConsentGrant {
  id             String    @id @default(cuid())
  caseId         String
  tenantId       String
  userId         String
  recipientClass String // clinic | attorney
  // Workstream I: the clinic the family named (null = any clinic, the shape
  // every grant had before the inbox existed). Plain reference, no FK: a
  // grant is the family's record and outlives the clinic's row.
  recipientOrganisationId String?
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?

  @@index([caseId])
}

// ENG-8 share-with-a-lawyer link: hashed token, expiring, revocable,
// access-logged ("your lawyer opened it").
model ShareLink {
  id         String    @id @default(cuid())
  caseId     String
  tenantId   String
  reportId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  accessLog  Json      @default("[]")
  createdAt  DateTime  @default(now())

  @@index([caseId])
}

// W-2 disclosure acknowledgment archive (E-6 chargeback defense, OPS-3).
// Retained 24 months, SURVIVES case deletion (retention matrix §11a.2) —
// plain references, no FKs. Contains the disclosure-set version + timestamp
// + IP/UA, never case content. Legitimate-interest retention basis
// confirmed (PO, Aug 2026).
model DisclosureAck {
  id                   String   @id @default(cuid())
  userId               String
  tenantId             String
  caseId               String? // linked at fulfillment
  disclosureSetVersion String
  ip                   String
  userAgent            String?
  ackAt                DateTime @default(now())

  @@index([userId, ackAt])
  @@index([caseId])
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  name                String?
  // Staff profile (ops /profile, 2026-09-09). `name` stays the display
  // name everywhere and is kept as "first last" when these are set.
  firstName           String?
  lastName            String?
  phone               String?
  passwordHash        String?
  role                Role        @default(ATTORNEY)
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  caseAccess          CaseAccess[]
  // Identity expand step (2026-10-19): which surface this person belongs to.
  // Backfilled from Role; Role stays authoritative for the staff gates until
  // the contract step. PROFESSIONAL accounts keep role CLIENT so every
  // existing staff gate refuses them.
  accountKind         AccountKind @default(FAMILY)
  grants              StaffGrant[]
  memberships         Membership[]
  // Professional profile (persona_rollout_plan §3): the Texas bar number is
  // stored unverified at sign-up; staff verify it from the queue (workstream G).
  barNumber           String?
  barState            String? // 'TX' when a bar number is set
  barVerifiedAt       DateTime?
  barVerifiedBy       String?
  practiceType        String? // writ | appellate | trial | pd | clinic | investigator | other

  passwordChangedAt   DateTime?
  // Activity for the admin's Accounts page: set by authorize() on every
  // successful credential sign-in. Visits live in UserVisit.
  lastLoginAt         DateTime?
  loginCount          Int         @default(0)
  deletedAt           DateTime? // account deletion (anonymized row; ledger FKs survive)
  // Email change (your_account spec U5): the new address is held until its
  // owner confirms from a link sent to it; sign-in keeps using `email`.
  pendingEmail        String?
  emailChangeToken    String?
  emailChangeExpires  DateTime?
  inviteToken         String?
  inviteExpires       DateTime?
  resetToken          String?
  resetExpires        DateTime?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  users        User[]
  cases        Case[]
  organisation Organisation?
}

enum CaseStatus {
  DRAFT
  AWAITING_DOCS
  DOCS_COMPLETE
  QUOTED // counsel only (workstream B): metered and priced, waiting for card, credit or allowance
  DIGITIZING
  ANALYZING
  ADJUDICATING
  QA_REVIEW
  QA_REJECTED
  READY
  DELIVERED
  REFUNDED
  DELETED
}

enum Lane {
  TRIAL
  PLEA
}

model Case {
  id        String   @id @default(cuid())
  title     String
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  documents Document[]
  accessList CaseAccess[]
  checklist  ChecklistItem[]
  matter     Matter?        // counsel intake (workstream C): present only when counsel opened the case as a matter

  // ENG-1 projection of the CaseEvent stream — updated ONLY by
  // appendCaseEvent in the same transaction as the event append.
  status         CaseStatus @default(DRAFT)
  lane           Lane?
  vehicle        String?    // 11.07 | 11.071 | 11.072 | 11.09 (S0 routing)
  subsequentWrit Boolean    @default(false) // E-7 hold flag
  ocrHalt        Boolean    @default(false) // E-1 hold flag
  delayOurs      Boolean    @default(false) // OPS-7 hold flag
  county         String?
  convictionYear Int?
  deadlineFacts  Json? // FR-5 inputs captured at interview (judgment/appeal/writ dates)
  facts          Json? // CaseFacts (case-lifecycle/facts.ts): what the family told us, kept once, never re-asked
  slaStartedAt   DateTime?  // stamped once by docs.complete (US-3)
  expectedReadyAt DateTime?

  // ── D: record inventory (persona_rollout_plan.md §4, §5 D) ──
  // Projection written only by inventory.service recomputeMeter: the bucket
  // from reporter's-record pages alone, the per-kind billable page counts,
  // and when they were last recomputed. Read-only everywhere else.
  recordBucket  String?   // SHORT | STANDARD | EXTENDED | LONG
  meteredPages  Json?     // { reporter, clerk, exhibit, unknown }
  inventoryAt   DateTime?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId, status])
}

// Append-only event stream (ENG-1 / system design §4). Like AuditLog:
// caseId is a plain reference, NOT a foreign key — the PII-minimal event
// skeleton survives case deletion (retention matrix §11a.2). publishedAt is
// the transactional-outbox marker: null = not yet published to Redis.
model CaseEvent {
  id          BigInt   @id @default(autoincrement())
  caseId      String
  tenantId    String   // denormalized so RLS + projections survive Case deletion
  type        String
  version     Int      @default(1)
  payload     Json
  actor       String   // userId | "system" | worker name — never free text
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([caseId, id])
  @@index([publishedAt])
}

// Anonymous S0 eligibility drafts (ENG-7): opaque token key, 30-day TTL then
// hard delete, promoted-then-deleted on purchase. Pre-tenant: no RLS.
// Pending-appeal families (customer_journey_ux_review G-E1): the one not-fit
// outcome that becomes a fit later. Email only, one reminder, never marketing.
model EligibilityLead {
  id         String    @id @default(cuid())
  email      String
  outcome    String
  remindAt   DateTime
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([remindAt])
}

model EligibilityDraft {
  token     String   @id
  answers   Json
  outcome   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

enum ChecklistItemState {
  NEEDED
  UPLOADED
  CONFIRMED
  PROBLEM
}

model ChecklistItem {
  id       String             @id @default(cuid())
  caseId   String
  case     Case               @relation(fields: [caseId], references: [id])
  kind     String             // judgment | indictment | clerks_record | rr_volume | ...
  label    String
  state    ChecklistItemState @default(NEEDED)
  howToKey String?            // copy-canon key for the "don't have this?" expander
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([caseId])
}

// Multipart/resumable upload sessions (ENG-4).
model UploadSession {
  id        String   @id @default(cuid())
  caseId    String
  s3Key     String
  parts     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([expiresAt])
}

model CaseAccess {
  id     String @id @default(cuid())
  caseId String
  userId String
  role   Role   @default(ADMIN)

  case Case @relation(fields: [caseId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([caseId, userId])
}

model Document {
  id        String   @id @default(cuid())
  filename  String
  s3Key     String? // where the original bytes live — required to return documents (US-11)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  chunks    DocumentChunk[]
  pages     DocumentPage[]

  // Echo-back (US-2/UI spec §5.5): the pipeline's classification guess and
  // the customer's confirm/correct verdict.
  suggestedChecklistItemId String?
  classificationConfirmed  Boolean @default(false)
  // ENG-4: infected uploads never reach digitization.
  quarantined              Boolean @default(false)

  // ── D: which volume of the record this file is (persona_rollout_plan.md §5 D).
  // Set by the uploader, or suggested from the filename and left unconfirmed
  // until the family says so. Never inferred from page text in this slice.
  volumeKind      VolumeKind @default(UNKNOWN)
  volumeLabel     String?    // e.g. "RR vol. 3 of 7"
  volumeIndex     Int?
  volumeCount     Int?
  volumeConfirmed Boolean    @default(false)
  ocrConfidence   Float?     // mean over its DocumentPages once digitised

  createdAt DateTime @default(now())
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  content    String
  embedding  Unsupported("vector(768)")?
  metadata   Json
}

model AuditLog {
  id        String   @id @default(cuid())
  // Plain references, deliberately NOT foreign keys: audit rows are append-only
  // and survive case deletion (retention matrix, mvp_v1_system_design.md §11a.2).
  // tenantId is denormalized so the RLS policy holds AFTER the Case is gone —
  // a post-deletion audit write must still be scoped and possible.
  caseId    String
  tenantId  String?
  action    String
  details   Json
  userId    String
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([tenantId])
}

model GraphState {
  thread_id     String
  checkpoint_id String
  checkpoint    String
  metadata      String
  created_at    DateTime @default(now())

  @@id([thread_id, checkpoint_id])
}

// One row per visit — a run of signed-in activity with no gap over
// VISIT_GAP_MS (visits.service). Fed by the web app's heartbeat (/me/visit).
// userId is a plain reference like the ledgers, and the rows are deleted with
// the account: they are behavioural data, not a record the business retains.
model UserVisit {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  startedAt  DateTime
  lastSeenAt DateTime
  pageViews  Int      @default(1)

  @@index([userId, lastSeenAt])
}

// Feature flags (persona_rollout_plan.md §5 J, §7 "Flags, not branches"):
// every professional surface ships dark behind one of these rows; a flip is
// a row update, never a deploy. System tables — no RLS, read on the owner
// connection only (packages/database/flags.ts). Overrides are keyed by
// tenantId, which is what RLS scopes on today; the Organisation model
// (1:1 with Tenant) arrives on its own branch.
model FeatureFlag {
  key         String                @id
  enabled     Boolean               @default(false)
  description String
  updatedBy   String?
  updatedAt   DateTime              @updatedAt
  overrides   FeatureFlagOverride[]
}

model FeatureFlagOverride {
  id        String      @id @default(cuid())
  flagKey   String
  flag      FeatureFlag @relation(fields: [flagKey], references: [key])
  tenantId  String
  enabled   Boolean
  note      String?
  updatedBy String
  updatedAt DateTime    @updatedAt

  @@unique([flagKey, tenantId])
}

// ── Workstream B: price book, credits, allowances, quotes, invoices ─────────
// (persona_rollout_plan.md §4 and §5 B.) The decisions live in
// packages/case-lifecycle/pricing (pure); these tables only store what it
// needs and what it decided. PriceBookRow is a system table seeded from
// DEFAULT_PRICE_BOOK by the migration; the rest are tenant data under RLS.

enum AllowanceKind {
  PILOT
  PUBLIC_INTEREST
  OFFICE
}

enum QuoteRequestStatus {
  OPEN
  QUOTED
  DECLINED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

// One row per audience × SKU × effective period, the shape of
// pricing/price-book.ts PriceBookRow. stripePriceId is resolved from the
// STRIPE_PRICE_* env at read time when null (price_data fallback).
model PriceBookRow {
  id            String    @id @default(cuid())
  audience      String // FAMILY | ATTORNEY | OFFICE | CLINIC
  sku           String
  cents         Int
  currency      String    @default("usd")
  stripePriceId String?
  label         String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  terms         Json?
  purchasable   Boolean   @default(true)

  @@unique([audience, sku, effectiveFrom])
  @@index([audience, sku])
}

// A prepaid record from a five-pack (pricing/credits.ts Credit). Spent by
// consumedCaseId so a retry on the same case can never spend a second one.
model Credit {
  id             String    @id @default(cuid())
  tenantId       String
  organisationId String?
  userId         String
  packId         String
  rung           String // SHORT | STANDARD | EXTENDED
  issuedAt       DateTime
  expiresAt      DateTime
  consumedAt     DateTime?
  consumedCaseId String?
  paymentId      String?

  @@index([tenantId, consumedAt])
  @@index([consumedCaseId])
}

// One row per record an organisation allowance paid for. The grant itself is
// on Organisation (allowanceRecords / allowanceResetsAt / pilot / pilotEndsAt);
// the ledger's `used` is a count of these. caseId is unique so the
// decrement at analysis start is idempotent.
model AllowanceEntry {
  id             String        @id @default(cuid())
  tenantId       String
  organisationId String
  caseId         String        @unique
  kind           AllowanceKind
  consumedAt     DateTime      @default(now())
  consumedBy     String

  @@index([organisationId])
  @@index([tenantId])
}

// A Long record (>1,500 reporter pages) is not sold to professionals until
// the volume split ships: the attorney asks, an admin answers from /ops.
model QuoteRequest {
  id           String             @id @default(cuid())
  tenantId     String
  caseId       String
  requestedBy  String
  meteredPages Json
  note         String?
  status       QuoteRequestStatus @default(OPEN)
  quotedCents  Int?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime           @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([caseId])
}

// ACH invoice for an office or clinic (plan §4): lines by matter and cause
// number. The PDF statement is the February slice; the row and mark-paid
// land now so the Money page can show them.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  organisationId String
  number         String        @unique // INV-2026-0001
  status         InvoiceStatus @default(DRAFT)
  totalCents     Int
  lines          Json // [{ caseId, causeNumber?, sku, cents }]
  issuedAt       DateTime?
  paidAt         DateTime?
  paidBy         String?
  achReference   String?
  createdAt      DateTime      @default(now())

  @@index([tenantId])
  @@index([organisationId])
  @@index([status])
}

// ── D: record inventory and volume recognition ──
// The three parts of a Texas criminal record as the uploader labels them;
// UNKNOWN is listed and counted, never dropped (plan §5 D).
enum VolumeKind {
  REPORTER
  CLERK
  EXHIBIT
  UNKNOWN
}

// ── Workstream I: clinics, offices, investigation layer (persona_rollout_plan.md §5 I) ──

// A seat offered to a colleague (OWNER only). The raw token travels in the
// email alone; the row keeps its sha256, exactly like User.inviteToken and
// ShareLink.tokenHash. Accepting creates (or re-seats) a PROFESSIONAL user.
model Invitation {
  id             String         @id @default(cuid())
  tenantId       String
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String
  role           MembershipRole
  tokenHash      String         @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([tenantId])
  @@index([organisationId, email])
}

// A consented packet in a clinic's inbox. tenantId is the CLINIC's tenant
// (the clinic reads its inbox under its own RLS context); caseId, reportId
// and consentGrantId point into the family's tenant and are read through the
// owner connection with the consent re-checked, as share links do. One
// delivery per clinic per report version.
model PacketDelivery {
  id             String       @id @default(cuid())
  tenantId       String
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sourceTenantId String
  caseId         String
  reportId       String
  consentGrantId String
  deliveredAt    DateTime     @default(now())
  openedAt       DateTime?
  openedBy       String?

  @@unique([organisationId, reportId])
  @@index([tenantId, deliveredAt])
}

enum InvestigationKind {
  CHRONOLOGY
  RECORDS_TRACKER
  OTHER
}

enum InvestigationStatus {
  OPEN
  IN_PROGRESS
  DELIVERED
  DECLINED
}

// A Record Desk request from an organisation member (investigator, attorney
// or owner). In January staff deliver by hand: a status change plus a note
// from the staff console, no file upload.
model InvestigationRequest {
  id             String              @id @default(cuid())
  tenantId       String
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  caseId         String?
  requestedBy    String
  kind           InvestigationKind
  pages          Int?
  dueBy          DateTime?
  note           String
  status         InvestigationStatus @default(OPEN)
  assignedTo     String?
  staffNote      String?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, createdAt])
  @@index([status])
}

// ── Matter intake for counsel (persona_rollout_plan.md §5 C, 2026-10-19) ─────
// A professional opens a MATTER instead of taking the family quiz. The matter
// is the counsel-facing shape of a Case (1:1): the vehicle chosen up front,
// the court-record identifiers, and the dates the TRAP clock and the deadline
// engine read. Client identity is INITIALS ONLY — no client name is stored
// (plan §3 UPL/privacy posture). tenantId is denormalised for the RLS policy
// like Membership; organisationId is the opener's organisation (1:1 with the
// tenant today, kept explicit for the office/clinic shapes).
model Matter {
  id                    String    @id @default(cuid())
  caseId                String    @unique
  case                  Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenantId              String
  organisationId        String
  openedBy              String    // userId of the professional who opened it
  vehicle               String    // CounselVehicle (case-lifecycle/trap/vehicles.ts)
  lane                  Lane?
  county                String
  court                 String?
  causeNumber           String?
  clientInitials        String    // 1–4 letters, upper-case; never a name
  offence               String?
  sentence              String?
  judgmentSignedAt      DateTime? @db.Date
  sentenceImposedAt     DateTime? @db.Date
  noticeOfAppealFiledAt DateTime? @db.Date
  recordFiledAt         DateTime? @db.Date
  priorWrits            Int       @default(0)
  subsequentWrit        Boolean   @default(false)
  outsideRecordNote     String?
  capital               Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId, organisationId])
  @@index([openedBy])
}

// ── J: the weekly eval gate (persona_rollout_plan.md §5 J, §7 "What runs on
// staging" item 2, §8 "Eval gate: weekly on all ledgers with cost per bucket") ─
// One row per ledger per gate run. A SYSTEM table (no RLS, owner connection):
// the gate reads across the eval tenant from the staff console and from the
// GitHub workflow's machine token. caseId / runId / tenantId are plain
// references so a deleted eval case leaves the gate history intact.
enum EvalRunStatus {
  QUEUED
  RUNNING
  SCORED
  FAILED
}

model EvalRun {
  id           String        @id @default(cuid())
  ledger       String        // ledger file name under docs/evaluation/ledgers (gary, brian, …)
  caseId       String        // the dedicated eval case this run created
  tenantId     String        // the eval tenant (Organisation.isTest = true)
  runId        String?       // AnalysisRun.id once the analysis finished
  status       EvalRunStatus @default(QUEUED)
  scorecard    Json?         // EvalScorecard + the run identity and the drop ratio
  pass         Boolean?      // gateVerdict(ledger, scorecard).pass
  reasons      Json?         // gateVerdict reasons (string[])
  bucket       String?       // SHORT | STANDARD | EXTENDED | LONG (classifyRecord)
  meteredPages Json?         // { reporter, clerk, exhibit, unknown }
  costCents    Int?          // CostRecord total for the eval case, in cents
  error        String?       // technical failure reason (never PII)
  triggeredBy  String        // userId, or "eval-gate" for the machine token
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?

  @@index([startedAt])
  @@index([ledger, startedAt])
}
