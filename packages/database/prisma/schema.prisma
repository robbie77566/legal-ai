generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  ATTORNEY
  INVESTIGATOR
  VIEWER
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  name                String?
  passwordHash        String?
  role                Role        @default(ATTORNEY)
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  caseAccess          CaseAccess[]

  passwordChangedAt   DateTime?
  inviteToken         String?
  inviteExpires       DateTime?
  resetToken          String?
  resetExpires        DateTime?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Tenant {
  id    String @id @default(cuid())
  name  String
  users User[]
  cases Case[]
}

enum CaseStatus {
  DRAFT
  AWAITING_DOCS
  DOCS_COMPLETE
  DIGITIZING
  ANALYZING
  ADJUDICATING
  QA_REVIEW
  QA_REJECTED
  READY
  DELIVERED
  REFUNDED
  DELETED
}

enum Lane {
  TRIAL
  PLEA
}

model Case {
  id        String   @id @default(cuid())
  title     String
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  documents Document[]
  accessList CaseAccess[]
  checklist  ChecklistItem[]

  // ENG-1 projection of the CaseEvent stream — updated ONLY by
  // appendCaseEvent in the same transaction as the event append.
  status         CaseStatus @default(DRAFT)
  lane           Lane?
  vehicle        String?    // 11.07 | 11.071 | 11.072 | 11.09 (S0 routing)
  subsequentWrit Boolean    @default(false) // E-7 hold flag
  ocrHalt        Boolean    @default(false) // E-1 hold flag
  delayOurs      Boolean    @default(false) // OPS-7 hold flag
  county         String?
  convictionYear Int?
  slaStartedAt   DateTime?  // stamped once by docs.complete (US-3)
  expectedReadyAt DateTime?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId, status])
}

// Append-only event stream (ENG-1 / system design §4). Like AuditLog:
// caseId is a plain reference, NOT a foreign key — the PII-minimal event
// skeleton survives case deletion (retention matrix §11a.2). publishedAt is
// the transactional-outbox marker: null = not yet published to Redis.
model CaseEvent {
  id          BigInt   @id @default(autoincrement())
  caseId      String
  tenantId    String   // denormalized so RLS + projections survive Case deletion
  type        String
  version     Int      @default(1)
  payload     Json
  actor       String   // userId | "system" | worker name — never free text
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([caseId, id])
  @@index([publishedAt])
}

// Anonymous S0 eligibility drafts (ENG-7): opaque token key, 30-day TTL then
// hard delete, promoted-then-deleted on purchase. Pre-tenant: no RLS.
model EligibilityDraft {
  token     String   @id
  answers   Json
  outcome   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

enum ChecklistItemState {
  NEEDED
  UPLOADED
  CONFIRMED
  PROBLEM
}

model ChecklistItem {
  id       String             @id @default(cuid())
  caseId   String
  case     Case               @relation(fields: [caseId], references: [id])
  kind     String             // judgment | indictment | clerks_record | rr_volume | ...
  label    String
  state    ChecklistItemState @default(NEEDED)
  howToKey String?            // copy-canon key for the "don't have this?" expander
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([caseId])
}

// Multipart/resumable upload sessions (ENG-4).
model UploadSession {
  id        String   @id @default(cuid())
  caseId    String
  s3Key     String
  parts     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([expiresAt])
}

model CaseAccess {
  id     String @id @default(cuid())
  caseId String
  userId String
  role   Role   @default(ADMIN)

  case Case @relation(fields: [caseId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([caseId, userId])
}

model Document {
  id        String   @id @default(cuid())
  filename  String
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  chunks    DocumentChunk[]
  createdAt DateTime @default(now())
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  content    String
  embedding  Unsupported("vector(768)")?
  metadata   Json
}

model AuditLog {
  id        String   @id @default(cuid())
  // Plain reference, deliberately NOT a foreign key: audit rows are append-only
  // and survive case deletion (retention matrix, mvp_v1_system_design.md §11a.2).
  caseId    String
  action    String
  details   Json
  userId    String
  createdAt DateTime @default(now())

  @@index([caseId])
}

model GraphState {
  thread_id     String
  checkpoint_id String
  checkpoint    String
  metadata      String
  created_at    DateTime @default(now())

  @@id([thread_id, checkpoint_id])
}
