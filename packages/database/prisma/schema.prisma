generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  ATTORNEY
  INVESTIGATOR
  VIEWER
  SUPPORT // staff: customer-facing reads + safe unblocking actions, never money or deletion
  CLIENT // consumer purchaser in a single-member tenant (ENG-7, auth design §12)
}

enum PaymentKind {
  REVIEW
  OVERAGE
  RERUN
  REFUND
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

// Financial ledger (ENG-5). Retained 7 years — survives case deletion
// (retention matrix §11a.2); caseId/userId are plain references, no FK.
model Payment {
  id              String        @id @default(cuid())
  stripeId        String        @unique // checkout session id (or promo_… for a free purchase)
  paymentIntentId String? // what Stripe keys refunds and disputes by
  chargeId        String?
  caseId          String?
  userId          String
  tenantId        String
  kind            PaymentKind
  status          PaymentStatus @default(PENDING)
  amountCents     Int
  refundedCents   Int           @default(0) // rollup of Refund rows
  refundedAt      DateTime?
  disputedAt      DateTime?
  disputeStatus   String? // open | won | lost
  promoCode       String? // attribution (promo_codes.md §5)
  // Receipt details for the family's account page, fetched from Stripe once
  // on first view and kept — brand and last four only, never more.
  cardBrand       String?
  cardLast4       String?
  receiptUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([caseId])
  @@index([tenantId])
  @@index([paymentIntentId])
  @@index([status])
  @@index([createdAt])
}

// Support contact log (OPS-6). Free text lives HERE, not in the event
// stream (events are PII-minimal by construction); the matching
// support.contacted event carries only the note id and channel.
model SupportNote {
  id        String   @id @default(cuid())
  caseId    String
  tenantId  String
  channel   String // email | phone | chat | internal
  body      String
  authorId  String
  createdAt DateTime @default(now())

  @@index([caseId])
}

enum StaffRequestType {
  REFUND
  CASE_DELETE
  ACCOUNT_DELETE
}

enum StaffRequestDecision {
  APPROVED
  DECLINED
}

// Request-to-Admin (staff_console_access_model §6): Support records the
// reason once; an Admin decides with it in front of them. One open request
// per case + type (partial unique index in the migration).
model StaffRequest {
  id           String                @id @default(cuid())
  caseId       String
  tenantId     String
  type         StaffRequestType
  reason       String
  note         String?
  amountCents  Int? // REFUND only; null = full
  requestedBy  String
  decision     StaffRequestDecision?
  decidedBy    String?
  decisionNote String?
  createdAt    DateTime              @default(now())
  decidedAt    DateTime?

  @@index([caseId])
  @@index([decision])
}

// Refund ledger (OPS-2): one row per refund actually issued, so partial
// refunds stack and the weekly refund total is a sum, not a guess. Same
// retention and plain-reference rules as Payment.
model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  stripeRefundId String   @unique
  caseId         String?
  tenantId       String
  amountCents    Int
  reason         String // unreadable_record | customer_request | chargeback | other
  note           String?
  issuedBy       String // staff userId, or "stripe" when first seen via webhook
  createdAt      DateTime @default(now())

  @@index([paymentId])
  @@index([tenantId])
  @@index([createdAt])
}

// Stripe webhook idempotency ledger (ENG-5): one row per processed event id.
model PaymentEvent {
  stripeEventId String   @id
  type          String
  processedAt   DateTime @default(now())
}

// The billable-page authority (ENG-3) + OCR record (NFR-6). One row per
// normalized page; the meter, the overage trigger, and refund math all
// COUNT(billable) here — one authority, no drift. Dedup semantics per
// §11a.3: exact-hash duplicates leave billing AND analysis; near-duplicates
// (when perceptual hashing lands) leave billing only.
model DocumentPage {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])
  pageNo        Int
  contentHash   String
  billable      Boolean  @default(true)
  dedupKind     String? // exact | near
  ocrConfidence Float?
  ocrProvider   String? // pdf-text | textract
  createdAt     DateTime @default(now())

  @@index([documentId])
  @@index([contentHash])
}

// ── Analysis pipeline (ENG-2, system design §6) ──────────────────────────────

model AnalysisRun {
  id          String    @id @default(cuid())
  caseId      String
  tenantId    String
  runNo       Int       @default(1)
  modelConfig Json // model/prompt/router versions — a QA'd report is reproducible
  // Case summary extracted from the record (case-lifecycle/summary.ts):
  // person, county, court, cause, offense, dates, verdict, sentence,
  // appeal, prior writs — each fact cited to the record or absent (2026-09-12).
  summary     Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([caseId])
}

// Promo codes (US-12, promo_codes.md): operator-global, owner-written.
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique // stored UPPERCASE
  amountOffCents Int // 1..29900; 29900 = free
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())
}

// Customer feedback (customer_feedback_program.md): one row per case,
// upserted across touches. Open text stays HERE only - never in analytics.
model CaseFeedback {
  id               String   @id @default(cuid())
  caseId           String   @unique
  tenantId         String
  clarity          Int? // Q1 CSAT 1-5
  recommend        String? // yes | not_sure | no  (Q2, the value proxy)
  decidedText      String? // "what did this report help you decide?"
  sharedWithLawyer String? // yes | planning | no (touch 2)
  objectionText    String? // "what almost stopped you?"
  followupSentAt   DateTime? // +7d email stamp (idempotence)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// NFR-4 cost telemetry: every model/OCR call writes a row, so per-case
// COGS is a single query. No FK (survives deletion like other ledgers);
// amountUsd is computed from env-configured rates — tokens are the truth,
// dollars are the estimate.
model CostRecord {
  id              String   @id @default(cuid())
  caseId          String
  tenantId        String
  source          String // model | ocr | storage
  provider        String // e.g. claude-opus-5, textract
  detail          String? // screen id, context_prepass, textract job…
  tokensIn        Int?
  tokensOut       Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  pages           Int?
  amountUsd       Float
  createdAt       DateTime @default(now())

  @@index([caseId])
}

// ENG-2 findings schema — the pipeline↔QA↔report contract.
model Finding {
  id           String  @id @default(cuid())
  runId        String
  caseId       String
  tenantId     String
  stableKey    String // hash(category + primary citation) — US-6 re-run diff
  category     String // preserved_error | iac | brady | junk_science | sentencing | deadline | appeal_restoration | new_evidence_flag
  severity     String // dispositive | supportive | background
  confidence   Float
  adjudication String  @default("not_run") // agree | disagree | not_run
  engine       String? // which engine produced the kept copy (multi-engine union)
  s4Tags       String[] @default([])
  partAText    String
  partBText    String
  provenance   String  @default("ai") // ai | ai_human_edited
  citations    FindingCitation[]

  @@index([caseId, runId])
}

model FindingCitation {
  id          String  @id @default(cuid())
  findingId   String
  finding     Finding @relation(fields: [findingId], references: [id])
  documentId  String
  volume      String?
  page        Int?
  line        Int?
  chunkId     String // + excerptHash: the FR-7 re-verification anchors
  excerptHash String
  excerpt     String

  @@index([findingId])
}

// ENG-8: QA approval snapshots the exact findings READY will render.
model Report {
  id               String   @id @default(cuid())
  caseId           String
  tenantId         String
  runId            String
  versionNo        Int      @default(1)
  templateVersion  String
  findingsSnapshot Json
  approvedBy       String
  renderedAt       DateTime @default(now())

  @@index([caseId])
}

// US-5 consent-based referral: opt-in only, default off, revocable; nothing
// is shared without an explicit grant. Events mirror grants/revocations.
model ConsentGrant {
  id             String    @id @default(cuid())
  caseId         String
  tenantId       String
  userId         String
  recipientClass String // clinic | attorney
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?

  @@index([caseId])
}

// ENG-8 share-with-a-lawyer link: hashed token, expiring, revocable,
// access-logged ("your lawyer opened it").
model ShareLink {
  id         String    @id @default(cuid())
  caseId     String
  tenantId   String
  reportId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  accessLog  Json      @default("[]")
  createdAt  DateTime  @default(now())

  @@index([caseId])
}

// W-2 disclosure acknowledgment archive (E-6 chargeback defense, OPS-3).
// Retained 24 months, SURVIVES case deletion (retention matrix §11a.2) —
// plain references, no FKs. Contains the disclosure-set version + timestamp
// + IP/UA, never case content. Legitimate-interest retention basis
// confirmed (PO, Aug 2026).
model DisclosureAck {
  id                   String   @id @default(cuid())
  userId               String
  tenantId             String
  caseId               String? // linked at fulfillment
  disclosureSetVersion String
  ip                   String
  userAgent            String?
  ackAt                DateTime @default(now())

  @@index([userId, ackAt])
  @@index([caseId])
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  name                String?
  // Staff profile (ops /profile, 2026-09-09). `name` stays the display
  // name everywhere and is kept as "first last" when these are set.
  firstName           String?
  lastName            String?
  phone               String?
  passwordHash        String?
  role                Role        @default(ATTORNEY)
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  caseAccess          CaseAccess[]

  passwordChangedAt   DateTime?
  deletedAt           DateTime? // account deletion (anonymized row; ledger FKs survive)
  // Email change (your_account spec U5): the new address is held until its
  // owner confirms from a link sent to it; sign-in keeps using `email`.
  pendingEmail        String?
  emailChangeToken    String?
  emailChangeExpires  DateTime?
  inviteToken         String?
  inviteExpires       DateTime?
  resetToken          String?
  resetExpires        DateTime?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Tenant {
  id    String @id @default(cuid())
  name  String
  users User[]
  cases Case[]
}

enum CaseStatus {
  DRAFT
  AWAITING_DOCS
  DOCS_COMPLETE
  DIGITIZING
  ANALYZING
  ADJUDICATING
  QA_REVIEW
  QA_REJECTED
  READY
  DELIVERED
  REFUNDED
  DELETED
}

enum Lane {
  TRIAL
  PLEA
}

model Case {
  id        String   @id @default(cuid())
  title     String
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  documents Document[]
  accessList CaseAccess[]
  checklist  ChecklistItem[]

  // ENG-1 projection of the CaseEvent stream — updated ONLY by
  // appendCaseEvent in the same transaction as the event append.
  status         CaseStatus @default(DRAFT)
  lane           Lane?
  vehicle        String?    // 11.07 | 11.071 | 11.072 | 11.09 (S0 routing)
  subsequentWrit Boolean    @default(false) // E-7 hold flag
  ocrHalt        Boolean    @default(false) // E-1 hold flag
  delayOurs      Boolean    @default(false) // OPS-7 hold flag
  county         String?
  convictionYear Int?
  deadlineFacts  Json? // FR-5 inputs captured at interview (judgment/appeal/writ dates)
  facts          Json? // CaseFacts (case-lifecycle/facts.ts): what the family told us, kept once, never re-asked
  slaStartedAt   DateTime?  // stamped once by docs.complete (US-3)
  expectedReadyAt DateTime?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId, status])
}

// Append-only event stream (ENG-1 / system design §4). Like AuditLog:
// caseId is a plain reference, NOT a foreign key — the PII-minimal event
// skeleton survives case deletion (retention matrix §11a.2). publishedAt is
// the transactional-outbox marker: null = not yet published to Redis.
model CaseEvent {
  id          BigInt   @id @default(autoincrement())
  caseId      String
  tenantId    String   // denormalized so RLS + projections survive Case deletion
  type        String
  version     Int      @default(1)
  payload     Json
  actor       String   // userId | "system" | worker name — never free text
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([caseId, id])
  @@index([publishedAt])
}

// Anonymous S0 eligibility drafts (ENG-7): opaque token key, 30-day TTL then
// hard delete, promoted-then-deleted on purchase. Pre-tenant: no RLS.
// Pending-appeal families (customer_journey_ux_review G-E1): the one not-fit
// outcome that becomes a fit later. Email only, one reminder, never marketing.
model EligibilityLead {
  id         String    @id @default(cuid())
  email      String
  outcome    String
  remindAt   DateTime
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([remindAt])
}

model EligibilityDraft {
  token     String   @id
  answers   Json
  outcome   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

enum ChecklistItemState {
  NEEDED
  UPLOADED
  CONFIRMED
  PROBLEM
}

model ChecklistItem {
  id       String             @id @default(cuid())
  caseId   String
  case     Case               @relation(fields: [caseId], references: [id])
  kind     String             // judgment | indictment | clerks_record | rr_volume | ...
  label    String
  state    ChecklistItemState @default(NEEDED)
  howToKey String?            // copy-canon key for the "don't have this?" expander
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([caseId])
}

// Multipart/resumable upload sessions (ENG-4).
model UploadSession {
  id        String   @id @default(cuid())
  caseId    String
  s3Key     String
  parts     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([expiresAt])
}

model CaseAccess {
  id     String @id @default(cuid())
  caseId String
  userId String
  role   Role   @default(ADMIN)

  case Case @relation(fields: [caseId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([caseId, userId])
}

model Document {
  id        String   @id @default(cuid())
  filename  String
  s3Key     String? // where the original bytes live — required to return documents (US-11)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  chunks    DocumentChunk[]
  pages     DocumentPage[]

  // Echo-back (US-2/UI spec §5.5): the pipeline's classification guess and
  // the customer's confirm/correct verdict.
  suggestedChecklistItemId String?
  classificationConfirmed  Boolean @default(false)
  // ENG-4: infected uploads never reach digitization.
  quarantined              Boolean @default(false)

  createdAt DateTime @default(now())
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  content    String
  embedding  Unsupported("vector(768)")?
  metadata   Json
}

model AuditLog {
  id        String   @id @default(cuid())
  // Plain references, deliberately NOT foreign keys: audit rows are append-only
  // and survive case deletion (retention matrix, mvp_v1_system_design.md §11a.2).
  // tenantId is denormalized so the RLS policy holds AFTER the Case is gone —
  // a post-deletion audit write must still be scoped and possible.
  caseId    String
  tenantId  String?
  action    String
  details   Json
  userId    String
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([tenantId])
}

model GraphState {
  thread_id     String
  checkpoint_id String
  checkpoint    String
  metadata      String
  created_at    DateTime @default(now())

  @@id([thread_id, checkpoint_id])
}
