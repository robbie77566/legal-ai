# Production INSPECTION credentials for the dev box (dev_prod_switching.md).
# Copy to .env.prod (gitignored). Nothing here is read by the running app —
# only by scripts invoked with --env prod. Read-only by construction.

# Read-only Postgres role on the prod database (docs/operations/sql/readonly_role.sql).
# Build it from Render → hg-postgres → Info → External Connection String,
# replacing the user/password with hg_readonly's. Keep ?sslmode=require.
PROD_DATABASE_URL="postgresql://hg_readonly:<password>@dpg-...ohio-postgres.render.com/familycasereview_7ik1?sslmode=require"

# Optional: Render API key (Account settings → API Keys) for `pnpm prod:logs`.
# RENDER_API_KEY=""

# Staging baseline (scripts/staging-baseline.sh): OWNER external connection string of
# hg-postgres-staging (Render → Info). Only databases ending in _staging are accepted.
# STAGING_DATABASE_URL="postgresql://<owner>:<password>@dpg-...ohio-postgres.render.com/familycasereview_staging?sslmode=require"
# STAGING_BASELINE_PASSWORD="staging-baseline-2026"   # every copied account gets this password
# STAGING_S3_SOURCE_BUCKET="snl-case-documents-327600375718"   # for --s3: prod bucket …
# STAGING_S3_TARGET_BUCKET=""                                  # … to the staging bucket (name must contain "staging")
