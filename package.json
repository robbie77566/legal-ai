{
  "name": "habeasgraph",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "vitest run --coverage",
    "db:seed:prod": "pnpm --filter @hg/database db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "rag:index": "npx tsx packages/ai/scripts/index-codebase.ts",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.1.0"
}
