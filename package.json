{
  "name": "habeasgraph",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "vitest run --coverage",
    "db:sync": "pnpm --filter @hg/database db:migrate:deploy && pnpm --filter @hg/database db:generate",
    "db:seed:prod": "pnpm --filter @hg/database db:seed",
    "env:drift": "node scripts/env-drift.cjs --local",
    "prod:case": "node scripts/prod-case.cjs",
    "render:inventory": "node scripts/render-inventory.cjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "rag:index": "npx tsx packages/ai/scripts/index-codebase.ts",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.1.0"
}
