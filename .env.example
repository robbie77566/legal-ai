# ── Database ──────────────────────────────────────────────────────────────────
# Port 5433 = Docker host port (container runs Postgres on 5432, mapped to 5433)
DATABASE_URL="postgresql://user:password@localhost:5433/legal_ai?schema=public"

# ── Auth (Next.js web app) ────────────────────────────────────────────────────
# Generate each secret with: openssl rand -hex 32
# NEXTAUTH_SECRET and TOKEN_SECRET must be different values.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"
TOKEN_SECRET="change-this-to-a-different-32-char-string"

# ── Redis (BullMQ queue backend) ──────────────────────────────────────────────
# Queue workers and Bull Board are disabled automatically when Redis is unreachable.
REDIS_URL="redis://localhost:6379"

# ── Neo4j (knowledge graph) ───────────────────────────────────────────────────
NEO4J_URI="bolt://localhost:7688"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# ── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-key-here"
OLLAMA_BASE_URL="http://localhost:11434"

# ── AWS S3 Document Storage ───────────────────────────────────────────────────
# Leave blank in local dev — S3 upload steps are skipped gracefully without credentials.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="habeasgraph-documents"
# S3_ENDPOINT="http://localhost:9000"  # Uncomment for MinIO / localstack

# ── Seed Config ───────────────────────────────────────────────────────────────
SYSTEM_TENANT_NAME="HabeasGraph System"
ADMIN_EMAIL="admin@yourfirm.local"
ADMIN_PASSWORD="change-before-use"

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
WORKER_CONCURRENCY=5

# ── Monitoring (optional — skip in local dev) ─────────────────────────────────
# SENTRY_DSN="https://xxx@oyyy.ingest.sentry.io/zzz"

# ── Phase 2: Email (Resend) ───────────────────────────────────────────────────
# Required for invitation emails and password reset. Not needed for Phase 1.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="HabeasGraph <noreply@yourdomain.com>"

# ── Legal API Credentials (MCP servers degrade gracefully without these) ──────
# CLIO_CLIENT_ID=""
# CLIO_CLIENT_SECRET=""

# API <-> Web origins (M0: CORS is pinned, never `origin: true`)
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
